{
  "name": "open-chess-lab",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build -w @open-chess-lab/shared && concurrently -n shared,server,web -c blue,green,magenta \"npm run dev -w @open-chess-lab/shared\" \"npm run dev -w @open-chess-lab/server\" \"npm run dev -w @open-chess-lab/web\"",
    "build": "npm run build -w @open-chess-lab/shared && npm run build -w @open-chess-lab/server && npm run build -w @open-chess-lab/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:migrate": "npm run db:migrate -w @open-chess-lab/server",
    "db:seed": "npm run db:seed -w @open-chess-lab/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
